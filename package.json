{
  "name": "atbinyar",
  "version": "1.29.0",
  "description": "AtbinYar - Math Lab",
  "main": "index.js",
  "private": true,
  "author": {
    "name": "Atbin Omidi",
    "email": "atbeenn@gmail.com"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/AtbeenLabs/MathLab-App.git"
  },
  "homepage": "https://github.com/AtbeenLabs/MathLab-App",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:icons": "node scripts/generate-icons.mjs",
    "test:math": "node scripts/test-app-math.cjs",
    "test:primecount": "node scripts/test-primecount-wasm.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "electron": "45.1.0",
    "electron-builder": "24.13.3",
    "@capacitor/assets": "3.0.5",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "com.atbinyar.mathlab",
    "productName": "AtbinYar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "manifest.json",
      "icon_192x192.png",
      "icon_512x512.png",
      "logo.png",
      "index.js",
      "package.json",
      "atbinyar-primecount-api.js",
      "primecount-worker.js",
      "THIRD_PARTY_LICENSES/primecount-COPYING.txt",
      "icon_maskable_512.png",
      "favicon.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AtbeenLabs",
        "repo": "MathLab-App",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icons",
      "maintainer": "Atbin Omidi <atbeenn@gmail.com>"
    },
    "artifactName": "AtbinYar_v${version}.${ext}"
  }
}
